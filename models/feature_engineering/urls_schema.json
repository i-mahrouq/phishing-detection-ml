{
  "columns": [
    "url_length",
    "hostname_length",
    "dot_count",
    "subdomain_count",
    "digit_count",
    "hyphen_count",
    "special_character_count",
    "is_https",
    "hostname_is_ip",
    "url_entropy",
    "suspicious_keyword_count",
    "path_length",
    "query_parameter_count"
  ],
  "dtype": "float32",
